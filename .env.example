# Copiez ce fichier en .env — qui n'est jamais versionné.

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://jylkfskotuafptaxujao.supabase.co
# Clé publique : elle part dans le navigateur, c'est prévu.
SUPABASE_ANON_KEY=
# Clé de service : elle contourne toutes les règles de sécurité.
# Uniquement côté serveur, jamais dans une page, jamais dans le dépôt.
SUPABASE_SERVICE_ROLE_KEY=

# --- Klipso ----------------------------------------------------------------
KLIPSO_INSTANCE=infoprodigital
# Détenue par la fonction de synchronisation seule.
KLIPSO_API_KEY=

# --- Eventmaker ------------------------------------------------------------
# Jeton d'API, passé en paramètre d'adresse : c'est le contrat de leur API,
# pas notre choix. Détenu par la fonction de synchronisation seule.
EVENTMAKER_TOKEN=

# --- Déploiement -----------------------------------------------------------
# Origines autorisées à appeler les fonctions, séparées par des virgules.
# Toute nouvelle adresse de déploiement doit y figurer.
ORIGINES_AUTORISEES=
