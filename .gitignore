.env
.env.local
node_modules/
# Ce que rapportent les scripts d'exploration de Klipso (`outils/scripts/klipso/`).
outils/scripts/klipso/brut/
outils/scripts/klipso/svg/
# `outils/donnees/` et les références figées de `outils/controles/` restent versionnés,
# eux : ils ne se régénèrent qu'avec le réseau ou une clé Klipso (plans.json,
# polices.json, lieux.json, source-demo.json), dans Chromium (logos-demo.json),
# ou font foi en intégration (types-acceptes.json, portes-acceptees.json).
# Sans eux, un clone neuf ne construit plus.
supabase/.temp/

# Empreinte de ce que Deno télécharge pour `npm run typage`. Les versions sont
# déjà épinglées dans les imports des fonctions : le versionner n'ajouterait
# qu'un fichier à faire vivre.
deno.lock

outils/chk.js

# Les pages fabriquées : Cloudflare les construit au déploiement
# (`wrangler.jsonc` `build`), la CI pour ses essais, chacun chez soi par
# `npm run construire`. Les versionner faisait d'une ligne de gabarit mille
# lignes de diff, et de deux branches un conflit sur du texte que personne
# n'avait tapé. Restent versionnées les deux parties de `web/` qui ne se
# refont qu'avec le réseau : les polices et la bibliothèque du dessin.
/web/*
!/web/polices/
!/web/bibliotheques/
outils/tpl-multi.html
# la version des pages remise au Worker, écrite par la construction
src/pages.mjs

# État local de `wrangler dev` : caches, bases de simulation, paquet temporaire.
# Il se refait tout seul, et ne décrit que la machine qui l'a produit.
.wrangler/

# Sorties de simulation : régénérées par `npm run fep26`, jamais relues par le code.
simulations/

# Ce que laissent les essais du navigateur : traces et rapport d'un échec.
test-results/
playwright-report/
